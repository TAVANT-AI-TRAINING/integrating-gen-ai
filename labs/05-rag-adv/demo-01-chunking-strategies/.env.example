# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ChromaDB Configuration
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME=chunking_demo

# Default chunking configuration (used for /ingest and /generate endpoints)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Semantic chunker configuration
SEMANTIC_BREAKPOINT_THRESHOLD_TYPE=percentile
SEMANTIC_BREAKPOINT_THRESHOLD_AMOUNT=90

# Parent-child splitter sizes
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400
