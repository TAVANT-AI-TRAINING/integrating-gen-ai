# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ChromaDB Configuration
# Two separate collections are used: one for baseline (fixed chunking), one for optimized (semantic)
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME_BASELINE=pipeline_baseline
COLLECTION_NAME_SEMANTIC=pipeline_semantic

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400
SEMANTIC_BREAKPOINT_THRESHOLD_TYPE=percentile
SEMANTIC_BREAKPOINT_THRESHOLD_AMOUNT=90

# Hybrid Search Weights (must sum to 1.0)
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# Re-ranking
# Model downloads from HuggingFace on first use (~80MB, cached in ~/.cache/huggingface)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=4
INITIAL_FETCH_K=20

# Retrieval
DEFAULT_K=4
