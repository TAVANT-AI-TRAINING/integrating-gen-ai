# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ChromaDB Configuration
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME=hybrid_search_demo

# Chunking (recursive, same as demo-12)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
DEFAULT_K=4

# Hybrid Search Weights (must sum to 1.0)
# dense_weight: how much to favour semantic similarity
# sparse_weight: how much to favour BM25 keyword matching
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
